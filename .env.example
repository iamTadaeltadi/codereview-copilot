# ---------------------------------------------------------------------------
# REQUIRED — the system will not function without these.
# scripts/check_env.py fails if any is missing or left at its placeholder.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=code_review
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery broker
REDIS_HOST=redis
REDIS_PORT=6379

# GitHub App — without these there is no login and no webhook verification
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
GITHUB_WEBHOOK_SECRET=

# LLM provider — at least one key must be set for a review to run.
# Model string format: PROVIDER::model-name
LLM_MODEL_NAME=CEREBRAS::deepseek-r1-distill-llama-70b
CEREBRAS_API_KEY=
CEREBRAS_API_BASE_URL=

# ---------------------------------------------------------------------------
# REQUIRED TO RUN A REVIEW END TO END — the API boots without these, but every
# review will fail with "LangGraph review agent not available".
# ---------------------------------------------------------------------------

LANGGRAPH_API_URL=http://agent-pipeline:8000
LANGGRAPH_API_KEY=
LANGGRAPH_REVIEW_ASSISTANT_ID=
LANGGRAPH_FEEDBACK_ASSISTANT_ID=
AI_USER_ID=1

# ---------------------------------------------------------------------------
# OPTIONAL — sensible defaults exist. Override only if you need to.
# ---------------------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Alternative LLM providers
HYPERBOLIC_API_KEY=
HYPERBOLIC_API_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=
DEEPINFRA_API_TOKEN=
DEEPINFRA_BASE_URL=

# Generation settings. Keep TEMPERATURE at 0.1 for experiment runs.
TEMPERATURE=0.1
MAX_TOKENS=32768
DEFAULT_MAX_TOOL_CALLS=7

# Observability
LANGSMITH_API_KEY=
SENTRY_DSN=
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=false

# Performance
CELERY_WORKER_CONCURRENCY=4
REDIS_MAX_CONNECTIONS=20
DATABASE_POOL_SIZE=10

# Feature flags
ENABLE_RATE_LIMITING=true
ENABLE_CACHING=true
ENABLE_METRICS=true
